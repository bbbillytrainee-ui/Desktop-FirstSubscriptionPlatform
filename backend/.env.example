# Copy to .env for local development. In production (Railway) set these as service variables.
# With ENV=production the API refuses to start if any secret below is left at its example value.

ENV=development

# Railway injects DATABASE_URL (postgresql://...); the asyncpg driver is added automatically.
DATABASE_URL=postgresql://mediverse@localhost:54329/mediverse_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# At least 32 random characters in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Production: COOKIE_DOMAIN=.mediverselifesciences.com and COOKIE_SECURE=true, so the refresh
# cookie set by api.<domain> is same-site with www.<domain>. Leave empty/false on localhost.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Exact frontend origins, comma-separated. Production: https://www.<domain>,https://<domain>
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
FRONTEND_URL=http://localhost:8443

# console = print emails to the log (development). resend = send via Resend.
EMAIL_BACKEND=console
RESEND_API_KEY=
# Until a domain is verified in Resend, only onboarding@resend.dev can send (to your own address).
EMAIL_FROM=Mediverse <onboarding@resend.dev>
